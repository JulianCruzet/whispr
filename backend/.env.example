# One .env for both backend services. Copy to backend/.env and fill in.
# Never commit .env or paste keys in chat.

# ---- Audio gateway (Node, src/) ----
PORT=8787
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Where the brain listens (default ws://localhost:8000/ws)
BRAIN_URL=

# ---- Brain (Python, app/) ----
ANTHROPIC_API_KEY=
JEV_API_KEY=
BRAVE_SEARCH_API_KEY=
# Photo to use if search fails or is slow; otherwise backend/assets/fallback.jpg is used.
FALLBACK_PHOTO_URL=
# Where the phone can reach the brain's /assets (for the cached photo). Not needed on Render.
PUBLIC_BASE_URL=http://localhost:8000

# ---- Both ----
# Optional. When set, the gateway must present it to the brain.
APP_SHARED_TOKEN=
