# Copy to .env and fill in. Never commit .env or paste keys in chat.
ANTHROPIC_API_KEY=
JEV_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional. Photo to use if search fails; otherwise backend/assets/fallback.jpg is used.
FALLBACK_PHOTO_URL=

# Optional. When set, the app must send it as an X-App-Token header or ?token= param.
APP_SHARED_TOKEN=

# Where the phone can reach this backend; used for the fallback photo URL.
# Not needed on Render, which sets RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=http://localhost:8000
